---
// Bespoke landing page for mcpwn (overrides Starlight's "/" route).
//
// Dark-first hero. EVERY internal link is built from import.meta.env.BASE_URL
// so it respects the /mcpwn/ project-Pages base; assets are ESM-imported so
// Astro emits base-prefixed, hashed URLs. The demo GIF is poster-framed and
// swaps to a static first frame under prefers-reduced-motion (no autoplay).
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/700.css";
import "../styles/theme.css";
import { Code } from "astro:components";
import demoGif from "../assets/demo.gif";
import demoPoster from "../assets/demo-poster.png";

const base = import.meta.env.BASE_URL; // "/mcpwn/"
const url = (p: string) => base + p.replace(/^\//, "");
const REPO = "https://github.com/moizxsec/mcpwn";
const INSTALL = "npm i -g @moizxsec/mcpwn";

const features = [
  {
    title: "Intercept",
    body: "Sit in the middle of a live MCP session — hold each JSON-RPC message and forward, drop, edit, or tamper it. The Repeater loop for AI agents.",
    href: url("guides/proxy/"),
  },
  {
    title: "Scan",
    body: "Self-driving, agent-free scanner: paginated enumeration, content sampling, optional fuzzing, and a --fail-on CI gate emitting JSON / Markdown / SARIF.",
    href: url("guides/scan/"),
  },
  {
    title: "Guard",
    body: "Point it defensively and it's a firewall on the agent↔server channel — allow / warn / sanitize / block, plus rug-pull pinning and provenance tainting.",
    href: url("guides/guard/"),
  },
  {
    title: "Templates",
    body: "Nuclei-style attack rule-packs with CWE + severity metadata. Load one with --template <id>; new packs appear in the gallery automatically.",
    href: url("templates/"),
  },
  {
    title: "DVMCP",
    body: "Damn-Vulnerable MCP — one intentionally-broken server per attack class, plus a CI-gradeable scoreboard that lights up the scanner and detectors.",
    href: url("dvmcp/"),
  },
  {
    title: "Advisory",
    body: "Turn findings into a self-contained HTML advisory and filled CVSS v3.1 + CWE GHSA-style markdown — the artifacts you drop into a write-up.",
    href: url("guides/report/"),
  },
];

const threats = [
  "Indirect injection",
  "Tool poisoning",
  "Tool shadowing",
  "Rug pull",
  "Sampling abuse",
  "Elicitation phishing",
  "Confused deputy",
  "Token passthrough",
  "SSRF",
  "Path traversal",
  "Command injection",
  "Data exfiltration",
  "Invisible unicode",
  "Provenance taint",
  "readOnlyHint lie",
];

const tabs = [
  {
    id: "watch",
    label: "Watch",
    code: "# Passive X-ray — watch all traffic, change nothing\nmcpwn -v -- npx -y @modelcontextprotocol/server-filesystem /tmp",
  },
  {
    id: "tamper",
    label: "Tamper",
    code: "# Apply JSON tamper rules to messages in flight\nmcpwn -r attack.json -- node ./my-server.js",
  },
  {
    id: "scan",
    label: "Scan",
    code: "# Self-driving scan — fail CI on findings at/above a severity\nmcpwn scan --fuzz --findings-out ./out --fail-on high -- node ./my-server.js",
  },
  {
    id: "wrap",
    label: "Wrap",
    code: "# Route your MCP client's servers through mcpwn (backed up, reversible)\nmcpwn wrap --client claude-desktop",
  },
];

const badges = [
  { alt: "npm version", src: "https://img.shields.io/npm/v/@moizxsec/mcpwn.svg", href: "https://www.npmjs.com/package/@moizxsec/mcpwn" },
  { alt: "npm downloads", src: "https://img.shields.io/npm/dm/@moizxsec/mcpwn.svg", href: "https://www.npmjs.com/package/@moizxsec/mcpwn" },
  { alt: "CI", src: `${REPO}/actions/workflows/ci.yml/badge.svg`, href: `${REPO}/actions/workflows/ci.yml` },
  { alt: "License: MIT", src: "https://img.shields.io/badge/License-MIT-blue.svg", href: `${REPO}/blob/main/LICENSE` },
  { alt: "node >= 18", src: "https://img.shields.io/node/v/@moizxsec/mcpwn.svg", href: "https://nodejs.org" },
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>mcpwn — Burp Suite for AI agents</title>
    <meta
      name="description"
      content="Intercept & tamper proxy for MCP traffic — X-ray and tamper the JSON-RPC between an AI agent and its MCP servers. Authorized testing only."
    />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <meta property="og:title" content="mcpwn — Burp Suite for AI agents" />
    <meta
      property="og:description"
      content="X-ray and tamper the traffic between an AI agent and its MCP servers."
    />
    <meta property="og:image" content="https://moizxsec.github.io/mcpwn/og.svg" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <a class="brand" href={url("")}>
        <span class="wordmark">mcpwn</span><span class="cursor" aria-hidden="true"></span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href={url("start/quickstart/")}>Docs</a>
        <a href={url("threats/")}>Threats</a>
        <a href={url("api/")}>API</a>
        <a href={REPO} rel="noopener">GitHub</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Model Context Protocol security</p>
          <h1 class="title">
            <span class="wordmark">mcpwn</span><span class="cursor" aria-hidden="true"></span>
          </h1>
          <p class="lead">
            X-ray and tamper the traffic between an AI agent and its MCP servers.
            An intercepting man-in-the-middle proxy for the Model Context
            Protocol — watch every JSON-RPC message, and rewrite the
            <strong>tool results the server sends back to the agent</strong>.
            Burp Suite, but for AI agents.
          </p>

          <div class="cta-row">
            <button
              id="copy-install"
              class="cta cta-copy"
              type="button"
              data-copy={INSTALL}
              aria-label="Copy install command"
            >
              <code>{INSTALL}</code>
              <span class="copy-label" aria-live="polite">copy</span>
            </button>
            <a class="cta cta-primary" href={url("start/quickstart/")}>Quickstart →</a>
            <a class="cta cta-ghost" href={REPO} rel="noopener">GitHub</a>
          </div>

          <ul class="badges" aria-label="Project badges">
            {
              badges.map((b) => (
                <li>
                  <a href={b.href} rel="noopener">
                    <img src={b.src} alt={b.alt} loading="lazy" height="20" />
                  </a>
                </li>
              ))
            }
            <li><span class="badge-static">0 runtime deps</span></li>
          </ul>

          <p class="warn" role="note">
            ⚠ Authorized testing only — use it on agents and servers you own or
            are explicitly authorized to assess.
          </p>
        </div>

        <figure class="demo">
          <picture>
            <source srcset={demoPoster.src} media="(prefers-reduced-motion: reduce)" />
            <img
              class="demo-img"
              src={demoGif.src}
              width={demoGif.width}
              height={demoGif.height}
              alt="mcpwn tampers a tool result in flight; the agent obeys the injected instruction and exfiltrates a secret"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <figcaption>tamper a tool result in flight → the agent obeys → a secret leaks</figcaption>
        </figure>
      </section>

      <section class="section" aria-labelledby="what-h">
        <h2 id="what-h">One tool, six jobs</h2>
        <div class="cards">
          {
            features.map((f) => (
              <a class="card" href={f.href}>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </a>
            ))
          }
        </div>
      </section>

      <section class="section" aria-labelledby="qs-h">
        <h2 id="qs-h">30-second quickstart</h2>
        <div class="tabs">
          {
            tabs.map((t, i) => (
              <input
                class="tab-radio"
                type="radio"
                name="qs"
                id={`qs-${t.id}`}
                checked={i === 0}
              />
            ))
          }
          <div class="tab-labels" role="tablist" aria-label="Quickstart commands">
            {
              tabs.map((t) => (
                <label class="tab-label" for={`qs-${t.id}`}>
                  {t.label}
                </label>
              ))
            }
          </div>
          <div class="tab-panels">
            {
              tabs.map((t) => (
                <div class={`tab-panel panel-${t.id}`}>
                  <Code code={t.code} lang="bash" theme="github-dark" />
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="threats-h">
        <h2 id="threats-h">Threat coverage</h2>
        <p class="section-sub">
          Fifteen MCP attack classes, each with a CWE, a detector/template/dvmcp
          server, and a fix.
        </p>
        <ul class="chips">
          {
            threats.map((t) => (
              <li>
                <a class="chip" href={url("threats/")}>
                  {t}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>

    <footer class="foot">
      <p>
        <span class="wordmark">mcpwn</span> — authorized testing only. MIT ©
        moizxsec.
      </p>
      <p class="foot-links">
        <a href={url("start/what/")}>Docs</a> ·
        <a href={url("project/security/")}>Security</a> ·
        <a href={url("project/contributing/")}>Contributing</a> ·
        <a href={REPO} rel="noopener">GitHub</a>
      </p>
    </footer>

    <script>
      const btn = document.getElementById("copy-install");
      if (btn) {
        btn.addEventListener("click", async () => {
          const label = btn.querySelector(".copy-label");
          try {
            await navigator.clipboard.writeText(btn.dataset.copy || "");
            if (label) {
              const prev = label.textContent;
              label.textContent = "copied ✓";
              setTimeout(() => (label.textContent = prev), 1500);
            }
          } catch {
            /* clipboard blocked — the command is still selectable */
          }
        });
      }
    </script>

    <style>
      :global(body) {
        margin: 0;
        background: var(--mcpwn-bg);
        color: var(--mcpwn-text);
        font-family: var(--mcpwn-sans);
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--mcpwn-accent);
        color: #0d1117;
        padding: 0.5rem 0.9rem;
        border-radius: 0 0 6px 0;
        z-index: 10;
      }
      .skip:focus {
        left: 0;
      }
      .wordmark {
        font-family: var(--mcpwn-mono);
        font-weight: 700;
        letter-spacing: -0.02em;
      }
      .cursor {
        display: inline-block;
        width: 0.56em;
        height: 1.05em;
        margin-left: 0.07em;
        vertical-align: -0.12em;
        background: var(--mcpwn-accent);
        animation: mcpwn-blink 1.1s steps(1) infinite;
      }
      @media (prefers-reduced-motion: reduce) {
        .cursor {
          animation: none;
        }
      }

      .nav {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1.1rem 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      .brand {
        font-size: 1.25rem;
        text-decoration: none;
        color: var(--mcpwn-text);
        display: inline-flex;
        align-items: center;
      }
      .nav-links {
        display: flex;
        gap: 1.1rem;
        flex-wrap: wrap;
      }
      .nav-links a {
        color: var(--mcpwn-muted);
        text-decoration: none;
        font-size: 0.92rem;
      }
      .nav-links a:hover {
        color: var(--mcpwn-accent);
      }

      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1.25rem 4rem;
      }

      .hero {
        display: grid;
        grid-template-columns: 1.3fr 1fr;
        gap: 2.5rem;
        align-items: center;
        padding: 2.5rem 0 3rem;
      }
      .eyebrow {
        font-family: var(--mcpwn-mono);
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--mcpwn-c2s);
        margin: 0 0 0.6rem;
      }
      .title {
        font-size: clamp(2.8rem, 7vw, 4.5rem);
        margin: 0 0 1rem;
        line-height: 1;
      }
      .lead {
        font-size: 1.1rem;
        color: var(--mcpwn-text);
        max-width: 42ch;
        margin: 0 0 1.5rem;
      }
      .lead strong {
        color: var(--mcpwn-s2c);
      }

      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem;
        margin-bottom: 1.4rem;
      }
      .cta {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.6rem 1rem;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 600;
        border: 1px solid var(--mcpwn-border);
        cursor: pointer;
      }
      .cta-copy {
        background: var(--mcpwn-code-bg);
        color: var(--mcpwn-text);
        font-family: var(--mcpwn-mono);
      }
      .cta-copy code {
        font-family: var(--mcpwn-mono);
        background: none;
        color: var(--mcpwn-accent);
      }
      .cta-copy .copy-label {
        font-family: var(--mcpwn-sans);
        font-size: 0.78rem;
        color: var(--mcpwn-muted);
      }
      .cta-primary {
        background: var(--mcpwn-accent);
        color: #0d1117;
        border-color: var(--mcpwn-accent);
      }
      .cta-ghost {
        background: var(--mcpwn-panel);
        color: var(--mcpwn-text);
      }
      .cta:hover {
        border-color: var(--mcpwn-accent);
      }

      .badges {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0;
        margin: 0 0 1.3rem;
        align-items: center;
      }
      .badges img {
        display: block;
      }
      .badge-static {
        display: inline-block;
        font-family: var(--mcpwn-mono);
        font-size: 0.72rem;
        font-weight: 700;
        color: #0d1117;
        background: var(--mcpwn-s2c);
        border-radius: 4px;
        padding: 0.14rem 0.5rem;
      }
      .warn {
        font-size: 0.85rem;
        color: var(--mcpwn-med);
        margin: 0;
      }

      .demo {
        margin: 0;
        background: var(--mcpwn-panel);
        border: 1px solid var(--mcpwn-border);
        border-radius: 12px;
        padding: 0.7rem;
        box-shadow: 0 16px 40px rgba(1, 4, 9, 0.5);
      }
      .demo-img {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 8px;
        max-height: 70vh;
        object-fit: contain;
        background: var(--mcpwn-code-bg);
      }
      .demo figcaption {
        font-family: var(--mcpwn-mono);
        font-size: 0.74rem;
        color: var(--mcpwn-muted);
        text-align: center;
        padding: 0.6rem 0.2rem 0.2rem;
      }

      .section {
        padding: 2.5rem 0 0;
      }
      .section h2 {
        font-size: 1.6rem;
        margin: 0 0 0.3rem;
      }
      .section-sub {
        color: var(--mcpwn-muted);
        margin: 0 0 1.2rem;
        max-width: 60ch;
      }

      .cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
        gap: 1rem;
        margin-top: 1.2rem;
      }
      .card {
        display: block;
        border: 1px solid var(--mcpwn-border);
        background: var(--mcpwn-panel);
        border-radius: 10px;
        padding: 1.1rem 1.2rem;
        text-decoration: none;
        color: inherit;
        transition: border-color 0.15s ease;
      }
      .card:hover {
        border-color: var(--mcpwn-accent);
      }
      .card h3 {
        margin: 0 0 0.4rem;
        font-family: var(--mcpwn-mono);
        font-size: 1.02rem;
        color: var(--mcpwn-accent);
      }
      .card p {
        margin: 0;
        font-size: 0.9rem;
        color: var(--mcpwn-muted);
      }

      .tabs {
        margin-top: 1.2rem;
      }
      .tab-radio {
        position: absolute;
        opacity: 0;
        pointer-events: none;
      }
      .tab-labels {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 0.6rem;
      }
      .tab-label {
        font-family: var(--mcpwn-mono);
        font-size: 0.85rem;
        padding: 0.35rem 0.85rem;
        border: 1px solid var(--mcpwn-border);
        border-radius: 6px;
        background: var(--mcpwn-panel);
        color: var(--mcpwn-muted);
        cursor: pointer;
      }
      .tab-panel {
        display: none;
      }
      /* Show the panel whose radio (in document order) is checked. */
      #qs-watch:checked ~ .tab-panels .panel-watch,
      #qs-tamper:checked ~ .tab-panels .panel-tamper,
      #qs-scan:checked ~ .tab-panels .panel-scan,
      #qs-wrap:checked ~ .tab-panels .panel-wrap {
        display: block;
      }
      #qs-watch:checked ~ .tab-labels label[for="qs-watch"],
      #qs-tamper:checked ~ .tab-labels label[for="qs-tamper"],
      #qs-scan:checked ~ .tab-labels label[for="qs-scan"],
      #qs-wrap:checked ~ .tab-labels label[for="qs-wrap"] {
        border-color: var(--mcpwn-accent);
        color: var(--mcpwn-accent);
      }
      .tab-radio:focus-visible ~ .tab-labels label {
        outline: 2px solid var(--mcpwn-accent);
        outline-offset: 2px;
      }

      .chips {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0;
        margin: 0;
      }
      .chip {
        display: inline-block;
        font-family: var(--mcpwn-mono);
        font-size: 0.8rem;
        padding: 0.3rem 0.7rem;
        border: 1px solid var(--mcpwn-border);
        border-radius: 999px;
        background: var(--mcpwn-panel);
        color: var(--mcpwn-text);
        text-decoration: none;
      }
      .chip:hover {
        border-color: var(--mcpwn-c2s);
        color: var(--mcpwn-c2s);
      }

      .foot {
        border-top: 1px solid var(--mcpwn-border);
        max-width: 1100px;
        margin: 2rem auto 0;
        padding: 1.5rem 1.25rem 3rem;
        color: var(--mcpwn-muted);
        font-size: 0.85rem;
      }
      .foot-links a {
        color: var(--mcpwn-muted);
        text-decoration: none;
      }
      .foot-links a:hover {
        color: var(--mcpwn-accent);
      }

      @media (max-width: 820px) {
        .hero {
          grid-template-columns: 1fr;
          gap: 1.8rem;
        }
        .demo {
          order: -1;
          max-width: 24rem;
        }
      }
    </style>
  </body>
</html>
