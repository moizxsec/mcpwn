{
  "name": "@moizxsec/mcpwn",
  "version": "0.2.0",
  "description": "Intercept & tamper proxy for MCP traffic — X-ray and tamper the JSON-RPC between an AI agent and its MCP servers. Burp Suite for AI agents. Authorized testing only.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "proxy",
    "mitm",
    "intercept",
    "ai-agent",
    "prompt-injection",
    "pentest"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcpwn": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moizxsec/mcpwn.git"
  },
  "homepage": "https://github.com/moizxsec/mcpwn#readme",
  "bugs": {
    "url": "https://github.com/moizxsec/mcpwn/issues"
  },
  "files": [
    "dist",
    "examples",
    "payloads",
    "schema",
    "templates",
    "action.yml",
    "docs/mcpwn.1",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "coverage": "c8 --include='src/engine/**' --include='src/core/**' --exclude='src/engine/intercept.ts' --exclude-after-remap --reporter=text --reporter=lcov npm test",
    "docs:api": "typedoc",
    "demo:server": "node examples/vulnerable-server.mjs",
    "demo:http": "node examples/vulnerable-server-http.mjs",
    "demo": "node examples/run-demo.mjs",
    "dvmcp": "node examples/dvmcp/index.mjs",
    "gif": "node tools/gen-gif.mjs",
    "man": "node dist/cli.js man > docs/mcpwn.1",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.11.0",
    "c8": "^10.1.3",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "pureimage": "^0.4.18",
    "typedoc": "^0.28.20",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.2"
  }
}
